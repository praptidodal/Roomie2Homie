# Server Configuration
# Note: Port 5000 is reserved by macOS AirPlay Receiver (ControlCenter), so 5001 is used by default.
PORT=5001
NODE_ENV=development

# Client Origin for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Database Configuration
# Default: Local standalone MongoDB (Offline-ready, runs locally without internet)
MONGODB_URI=mongodb://127.0.0.1:27017/roomie2homie
# Optional: Remote MongoDB Atlas (Cloud / Production)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/roomie2homie?retryWrites=true&w=majority

# JWT Authentication Configuration
# Must be a cryptographically strong secret at least 32 characters long
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Document Encryption Key (Optional, falls back to JWT_SECRET if omitted)
# VERIFICATION_ENCRYPTION_KEY=replace_with_a_secure_encryption_key_at_least_32_chars

# Designated user email for running seed-rooms script (Optional)
# SEED_USER_EMAIL=host@example.com

# Seed script credentials (Optional for local development seeding)
# SEED_DEFAULT_PASSWORD=your_dev_user_password
# SEED_ADMIN_PASSWORD=your_dev_admin_password
# SEED_STUDENT_PASSWORD=your_dev_student_password

